<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0a">

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:background="#0f0f0f"
        android:gravity="center_vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" ▸VPR " android:textColor="#2196F3" android:textStyle="bold"
            android:textSize="13sp" android:fontFamily="monospace"/>

        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="#1a1a1a"/>

        <HorizontalScrollView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:id="@+id/sessionTabBar"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="4dp" android:paddingEnd="4dp"/>
        </HorizontalScrollView>

        <!-- SVG Delete Icon Button -->
        <ImageButton
            android:id="@+id/btnClearSession"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_delete"
            android:background="@android:color/transparent"
            android:layout_marginEnd="4dp"
            android:contentDescription="Clear Session"/>

        <Button android:id="@+id/btnNewSession"
            android:layout_width="wrap_content" android:layout_height="32dp"
            android:text="+ Sesi" android:textSize="11sp"
            android:textColor="#000000" android:backgroundTint="#2196F3"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/terminalContainer"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#0a0a0a"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
        android:orientation="horizontal" android:background="#0f0f0f"
        android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="❯ " android:textColor="#2196F3"
            android:textSize="16sp" android:fontFamily="monospace"/>

        <EditText android:id="@+id/cmdInput"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@null"
            android:textColor="#2196F3" android:textColorHint="#1a3a5c"
            android:hint="command / main.py / main.sh / main.js"
            android:textSize="13sp" android:fontFamily="monospace"
            android:imeOptions="actionSend" android:singleLine="true"
            android:inputType="text"/>

        <Button android:id="@+id/btnUpload"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="↑ File" android:textSize="11sp"
            android:textColor="#000000" android:backgroundTint="#FFD700"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:layout_marginStart="4dp"/>

        <Button android:id="@+id/btnSend"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="▶ Run" android:textSize="11sp"
            android:textColor="#000000" android:backgroundTint="#2196F3"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
